# ---- App ----
ENV=dev
LOG_LEVEL=info
# Comma-separated origins allowed to call the API with credentials (frontend dev + prod)
CORS_ORIGINS=http://localhost:5173

# ---- Auth ----
# HS256 secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRY_SECONDS=3600
# Cookie flags. Set COOKIE_SECURE=false only for local http testing.
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ---- Database (host Postgres — not run by compose) ----
# Host is `localhost` for a local `uv run`, `host.docker.internal` from the
# compose containers (mapped via extra_hosts). Provision roles first with
# docker/postgres-init.sh.
#
# Runtime app user: RLS-constrained, NEVER owns schema, NEVER runs migrations.
DATABASE_URL=postgresql+asyncpg://nobojatra_app:app-pw@localhost:5432/nobojatra
# Schema-owner user: migrations only.
DATABASE_URL_OWNER=postgresql+asyncpg://nobojatra_owner:owner-pw@localhost:5432/nobojatra
# Runtime role name (must match DATABASE_URL's user) — RLS policies + GRANTs target it.
APP_DB_USER=nobojatra_app

# Used only by docker/postgres-init.sh when you run it to provision the DB + roles.
POSTGRES_DB=nobojatra
POSTGRES_USER=nobojatra_owner
POSTGRES_PASSWORD=owner-pw
APP_DB_PASSWORD=app-pw

# ---- AWS S3 (SSE required) ----
# Leave S3_ENDPOINT_URL blank for real AWS. Set it only for a custom/S3-compatible
# endpoint (in which case the bucket is auto-created on startup).
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=nobojatra-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# AES256 (SSE-S3) or aws:kms. Bucket should also have default encryption enabled.
S3_SSE=AES256

# ---- ntfy (push delivery only; DB is source of truth) ----
NTFY_URL=http://localhost:8080
NTFY_TOPIC_PREFIX=portal-dev
NTFY_TOKEN=
